---
import EmailIcon from '../components/icons/email.astro';
import PhoneIcon from '../components/icons/phone.astro';
import StyledList from '../components/styled-list.astro';
import Layout from '../layouts/layout.astro';
import { siteConfig } from '../lib/site-config';

const contactDetails = [
	{
		href: `tel:${siteConfig.phone}`,
		icon: PhoneIcon,
		label: 'Phone',
		value: siteConfig.phone,
	},
	{
		href: `mailto:${siteConfig.email}`,
		icon: EmailIcon,
		label: 'Email',
		value: siteConfig.email,
	},
];
---

<Layout>
	<div class="flex flex-col gap-6">
		<div class="flex flex-wrap items-end gap-4">
			{
				contactDetails.map((item) => (
					<a
						class:list={[
							'bg-ice flex flex-1 items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-bold whitespace-nowrap shadow-sm transition',
							'hover:-translate-y-1 hover:shadow-lg',
						]}
						href={item.href}
					>
						<item.icon class="group-hover:text-mist w-6 fill-current text-gray-600" />
						{item.label}: {item.value}
					</a>
				))
			}
		</div>
		<div class="prose">
			<h1 class="font-display text-gray-700">
				Rainwater Tank Installations, Pumps, Filtration & Specialist Plumbing
			</h1>

			
				
<p>
    <span class="font-bold">Tanks For Rain Pty Ltd, trading as Report Plumbing,</span>{' '}
    provides professional rainwater tank installations, tank plumbing connections,
    pressure pump systems and water filtration throughout Port Macquarie and
    the Mid North Coast. We also specialise in leak detection, water ingress
    investigations and detailed plumbing reporting.
</p>

		

			<p>
				We work with insurers, insurance builders, strata managers, property
				managers, commercial clients, strata properties and homeowners to
				identify the source of water issues and provide practical repair
				recommendations.
			</p>
			
<StyledList
	items={[
		'Rainwater tank installations and replacements',
		'Steel and poly rainwater tank installations',
		'Rainwater tank plumbing connections and overflows',
		'Pressure pumps and rainwater supply systems',
		'Whole-house and under-sink water filtration',
		'Escape of water investigations',
		'Leak detection and diagnostic plumbing',
		'Thermal imaging',
		'Water ingress investigations',
		'Pressure testing and fault finding',
		'Positive smoke testing for drainage and odour investigations',
		'Insurance and plumbing reports',
		'Stormwater investigations',
		'Hot water diagnosis and repairs',
		'Commercial and strata plumbing',
	]}
/>


			<p>
				Based in Port Macquarie, we service the wider Mid North Coast including
				Wauchope, Laurieton, Kew, the North Shore and surrounding areas.
			</p>

			<p>
				With over <span class="font-bold">25 years experience</span>, our focus
				is on finding the problem, explaining it clearly and getting the right
				repair done.
			</p>

		
<p>
	<span class="font-bold">Need a rainwater tank installed, a pump connected, water filtration or specialist plumbing services?</span>
	Call Report Plumbing, trading under Tanks For Rain Pty Ltd, on
	<span class="font-bold">0404 222 244</span>.
</p>

		</div>
	</div>
</Layout>
